  <PropertyGroup>
    <!-- 第三方依赖一律从 GitHub 检出，默认按「与本仓库同级」摆放（.github/workflows/build.yml
         就是这么 checkout 的）：..\Ling、..\gifski。
         放在别处用命令行覆盖即可，属性只在外部没定义时生效，/p: 能盖住这里的默认值：
           msbuild Src\ScreenCapture.vcxproj /p:LingDir=D:\project\Ling /p:GifskiDir=D:\sdk\gifski -->
    <DepsRoot Condition="'$(DepsRoot)' == ''">$(MSBuildThisFileDirectory)..\..</DepsRoot>
    <LingDir Condition="'$(LingDir)' == ''">$(DepsRoot)\Ling</LingDir>
    <GifskiDir Condition="'$(GifskiDir)' == ''">$(DepsRoot)\gifski</GifskiDir>
    <!-- 直接用 msbuild 生成 .vcxproj（不经过解决方案）时 SolutionDir 是空的，
         下面的 IntDir 和默认 OutDir 都会算到奇怪的地方去。这里补成仓库根目录，
         产物落点就和走解决方案时完全一致：<仓库根>\x64\<配置>\ -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\</SolutionDir>
  </PropertyGroup>
