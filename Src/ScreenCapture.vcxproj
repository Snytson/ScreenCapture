  <PropertyGroup>
    <!-- Ling / gifski 都是第三方依赖，声明成「外部头文件目录」（映射到 /external:I）。
         配合下面 x64 配置里的 /external:anglebrackets /external:W0，MSVC 就不再从这些
         头文件里往外抛警告了 —— 比如 Ling::Util::getIndex 的返回类型是 int，
         而 std::ranges::distance 给的是 __int64（x64 上的 ptrdiff_t），会报 C4244。
         自己的代码仍然照常按 Level3 报警告。
         注意：这些目录只能出现在这里，不能再重复写进 AdditionalIncludeDirectories，
         同一个目录同时挂在 /I 和 /external:I 下行为未定义。 -->
    <ExternalIncludePath>$(LingDir);$(GifskiDir);$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>
